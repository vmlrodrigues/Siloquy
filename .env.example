# Release configuration — copy this file to .env and fill in your values.
# .env is gitignored and will never be committed.

# ── Notarisation (App Store Connect API key) — used by `make release` ──
# Keeps the credential out of the keychain; the .p8 stays on disk.
#   NOTARY_KEY     path to your AuthKey_XXXX.p8 — keep it in ~/.appstoreconnect/private_keys/,
#                  Apple's conventional dir (notarytool & xcodebuild auto-discover keys there)
#   NOTARY_KEY_ID  the 10-char key id (the XXXX in the filename)
#   NOTARY_ISSUER  App Store Connect issuer id (UUID) — Users and Access → Integrations
NOTARY_KEY="$HOME/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8"
NOTARY_KEY_ID=XXXXXXXXXX
NOTARY_ISSUER=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── WebDAV docs deployment ──

# Root URL of the WebDAV server (no trailing path).
WEBDAV_URL=https://webdav.example.com

# Path on the server where files should be uploaded, relative to WEBDAV_URL.
# Example: siloquy/docs
WEBDAV_REMOTE_PATH=your/remote/path

# Credentials for the WebDAV server
WEBDAV_USER=your-username
WEBDAV_PASS=your-password

# The volume name that macOS assigns when the share is mounted.
# Run './tools/deploy-docs.sh mount' once without this set, then check
# what appeared under /Volumes/ and paste that name here.
# Example: WEBDAV_VOLUME_NAME=files
WEBDAV_VOLUME_NAME=
